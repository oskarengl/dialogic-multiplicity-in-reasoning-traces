{"text": "1/2 = 0.5", "start": 965, "end": 974, "label": "inform"}
{"text": "Then:", "start": 976, "end": 981, "label": "none"}
{"text": "5 - 0.5 = 4.5", "start": 983, "end": 996, "label": "inform"}
