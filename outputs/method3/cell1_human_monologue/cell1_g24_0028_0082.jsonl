{"text": "2 plus 9, I'd get to 19.", "start": 84, "end": 108, "label": "inform"}
{"text": "That doesn't do it.", "start": 109, "end": 128, "label": "inform"}
{"text": "10 plus 7 is 17.", "start": 129, "end": 145, "label": "inform"}
{"text": "17 plus 12 is 29.", "start": 146, "end": 163, "label": "inform"}
{"text": "Doesn't do it.", "start": 164, "end": 178, "label": "inform"}
{"text": "What is 12 times 7 minus 12 times 7?", "start": 179, "end": 215, "label": "setQuestion"}
{"text": "84.", "start": 216, "end": 219, "label": "answer"}
{"text": "7, 84.", "start": 220, "end": 226, "label": "inform"}
